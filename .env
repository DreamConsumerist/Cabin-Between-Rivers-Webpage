VITE_APP_ENVIRONMENT="development"

# Real local Postgres for `netlify dev` (see scripts/local-db.mjs) — bypasses
# netlify dev's built-in PGlite database, which lacks the Postgres extensions
# some migrations need (e.g. btree_gist). Run `pnpm db:local` in a separate
# terminal alongside `netlify dev` to start it.
LOCAL_DATABASE_URL="postgres://postgres:postgres@localhost:5433/cabin_dev"